LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LIFF_ID_SCHEDULE=1234567890-xxxxxxxx
SECRET_KEY=your-random-secret-key-here

# PostgreSQL password for the local database container
DB_PASSWORD=change-this-to-a-strong-password

# DATABASE_URL is auto-set by docker-compose; only override if using external DB
DATABASE_URL=

DATABASE_PATH=data/when2meet.db
BACKUP_DIR=backups
BASE_URL=https://YOUR_PUBLIC_IP.sslip.io
PORT=5000
